{
  "structural_rules": {
    "strip_top_n_percent": 0.05,
    "strip_bottom_n_percent": 0.05
  },
  "layout": {
    "top_band_pct": 0.08,
    "bottom_band_pct": 0.08,
    "page_number_band_pct": 0.15,
    "furniture_min_pages": 3,
    "furniture_page_ratio": 0.5,
    "max_furniture_chars": 240,
    "min_gutter_pt": 8.0,
    "row_gap_pt": 12.0,
    "stitch_paragraphs": true
  },
  "global_noise_patterns": [
    "^(?!\\s*$).*\\d{4}.*ISSN.*$",
    "^(Page\\s+\\d+\\s+of\\s+\\d+)$",
    "^(©\\s*\\d{4}.*)",
    "^(.*\\d{6}\\s*\\|\\s*\\d{4}\\.\\d{2}\\.\\d{2}.*)",
    "(?i)^(confidential|proprietary|do not distribute|draft)\\b.{0,40}$",
    "(?i)(available\\s+@\\s+http[s]?://\\S+)",
    "_{3,}",
    "(?i)ModelSim.*Standard Edition"
  ],
  "stop_markers": [
    "REFERENCES",
    "BIBLIOGRAPHY",
    "LITERATURE CITED",
    "WORKS CITED",
    "REVISION HISTORY",
    "DOCUMENT VERSION",
    "SPONSOR",
    "APPENDIX",
    "INDEX"
  ],
  "section_markers": {
    "abstract": ["ABSTRACT"],
    "conclusion": ["CONCLUSION", "SUMMARY", "CONCLUDING REMARKS"]
  }
}