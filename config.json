{
  "structural_rules": {
    "strip_top_n_percent": 0.05,
    "strip_bottom_n_percent": 0.05
  },
  "global_noise_patterns": [
    "^(?!\\s*$).*\\d{4}.*ISSN.*$",
    "^(Page\\s+\\d+\\s+of\\s+\\d+)$",
    "^(©\\s*\\d{4}.*)",
    "^(.*\\d{6}\\s*\\|\\s*\\d{4}\\.\\d{2}\\.\\d{2}.*)",
    "(?i)(confidential|proprietary|do not distribute|draft)",
    "(?i)(available\\s+@\\s+http[s]?://\\S+)",
    "_{3,}",
    "(?i)ModelSim.*Standard Edition"
  ],
  "stop_markers": [
    "REFERENCES",
    "BIBLIOGRAPHY",
    "LITERATURE CITED",
    "WORKS CITED",
    "REVISION HISTORY",
    "DOCUMENT VERSION",
    "SPONSOR",
    "APPENDIX",
    "INDEX"
  ],
  "section_markers": {
    "abstract": ["ABSTRACT"],
    "conclusion": ["CONCLUSION", "SUMMARY", "CONCLUDING REMARKS"]
  }
}